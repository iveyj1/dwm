#!/bin/sh
# Next absolute level
set -eu
cur=$(brightnessctl get) || { echo "brightness-up: cannot read backlight" >&2; exit 1; }
max=$(brightnessctl max) || exit 1
case $cur in ''|*[!0-9]*) echo "brightness-up: invalid brightness" >&2; exit 1;; esac
case $max in ''|*[!0-9]*) echo "brightness-up: invalid maximum" >&2; exit 1;; esac
[ "$max" -gt 0 ] || { echo "brightness-up: maximum must be positive" >&2; exit 1; }
target=$(awk -v cur="$cur" -v max="$max" 'BEGIN {
    # split("1 1000 2000 4000 8000 16000 32000 64000", levels, " ")
    split("1 2000 8000 16000 32000 64000", levels, " ")
    # for (i = 1; i <= 8; i++) {
    for (i = 1; i <= 6; i++) {
        if (levels[i] >= max) break
        if (levels[i] > cur) {
            printf "%.0f\n", levels[i]
            exit
        }
    }
    printf "%.0f\n", max
}')
exec brightnessctl set "$target"
