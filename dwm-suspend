#!/bin/sh
# systemd's loginctl does not implement suspend. Do not retry a different
# backend after a permission/service failure from the selected backend.
set -eu

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
	exec systemctl suspend
fi
if command -v loginctl >/dev/null 2>&1 &&
	loginctl --version 2>/dev/null | grep -qi elogind; then
	exec loginctl suspend
fi

echo "dwm-suspend: no running systemd or identifiable elogind backend" >&2
exit 1
